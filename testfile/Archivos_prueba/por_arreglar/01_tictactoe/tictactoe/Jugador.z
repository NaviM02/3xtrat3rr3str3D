public class Jugador {
    protected String nombre;
    protected int ficha;
    protected int victorias;

    public Jugador(String nombre, int ficha) {
        this.nombre = nombre;
        this.ficha = ficha;
        this.victorias = 0;
    }

    public String getNombre() {
        return nombre;
    }

    public void ganar() {
        victorias++;
    }

    public int getVictorias() {
        return victorias;
    }

    public boolean jugar(Tablero t) {
        return false;
    }
}
