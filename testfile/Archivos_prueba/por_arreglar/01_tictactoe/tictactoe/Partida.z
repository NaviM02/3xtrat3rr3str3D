public class Partida {
    private Tablero tablero;
    private Jugador j1;
    private Jugador j2;
    private int turnos;

    public Partida(Jugador primero, Jugador segundo) {
        this.tablero = new Tablero();
        this.j1 = primero;
        this.j2 = segundo;
        this.turnos = 0;
    }

    public int jugar() {
        int turno = 1;
        int ganador = 0;

        while (ganador == 0 && !tablero.lleno()) {
            turnos++;
            boolean ok;
            if (turno == 1) {
                println("Turno " + turnos + ": " + j1.getNombre());
                ok = j1.jugar(tablero);
            } else {
                println("Turno " + turnos + ": " + j2.getNombre());
                ok = j2.jugar(tablero);
            }

            if (!ok) {
                println("Jugada invalida: termina la partida");
                break;
            }

            ganador = tablero.ganador();
            turno = 3 - turno;
        }

        tablero.dibujar();

        if (ganador == 1) {
            j1.ganar();
            println("Gana " + j1.getNombre());
        } else if (ganador == 2) {
            j2.ganar();
            println("Gana " + j2.getNombre());
        } else {
            println("Empate");
        }
        return ganador;
    }
}
