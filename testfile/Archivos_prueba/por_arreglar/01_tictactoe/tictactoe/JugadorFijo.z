public class JugadorFijo extends Jugador {
    private int[] filas = new int[9];
    private int[] columnas = new int[9];
    private int cantidad;
    private int paso;

    public JugadorFijo(String nombre, int ficha) {
        super(nombre, ficha);
        this.cantidad = 0;
        this.paso = 0;
    }

    public void agregarJugada(int fila, int columna) {
        filas[cantidad] = fila;
        columnas[cantidad] = columna;
        cantidad++;
    }

    @Override
    public boolean jugar(Tablero t) {
        if (paso >= cantidad) {
            return false;
        }
        boolean ok = t.colocar(filas[paso], columnas[paso], ficha);
        paso++;
        return ok;
    }
}
